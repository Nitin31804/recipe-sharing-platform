{
  "name": "html-css-js-project",
  "version": "1.0.0",
  "description": "A modern registration form with advanced validation, real-time feedback, and professional design",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "lint": "echo 'No linter configured yet'",
    "server": "node backend-example/server.js"
  },
  "keywords": [
    "registration",
    "form",
    "validation",
    "html",
    "css",
    "javascript"
  ],
  "author": "Nitin31804",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0"
  },
  "optionalDependencies": {
    "axios": "^1.3.0",
    "bcrypt": "^5.1.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "nodemailer": "^6.9.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
